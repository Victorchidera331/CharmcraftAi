# Required for /api/health and PostgreSQL-backed features.
# Set this value in Vercel Project Settings → Environment Variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional: enables the configured remote LLM path for Coach Victor.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
